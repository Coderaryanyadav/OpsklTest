# OPSKL disposable Docker test environment (placeholders only).
#
# Copy this file to .env.docker.test (gitignored), then fill the values from the
# local Supabase CLI status output. Never put production credentials here.
#
#   npx supabase start
#   npx supabase status -o env
#
# The local demo keys are not production secrets, but they are still gitignored
# and must not be pasted into reports or committed.

# Host-side Supabase endpoint used by the browser and host Playwright runs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-supabase-anon-key>
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local-supabase-anon-key>

# Test-runner-only values. The service role key must never be exposed to app images.
SUPABASE_SERVICE_ROLE_KEY=<local-supabase-service-role-key>
SUPABASE_ANON_KEY=<local-supabase-anon-key>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_APP_ENV=test
NEXT_PUBLIC_DEFAULT_CITY=Mumbai
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
EXPO_PUBLIC_APP_ENV=test
EXPO_PUBLIC_DEFAULT_CITY=Mumbai
EXPO_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# Synthetic identities. These are not real people and are safe to recreate.
ADMIN_EMAIL=admin@test.opskil.local
ADMIN_PASSWORD=<synthetic-admin-password>
WORKER_EMAIL=worker@test.opskil.local
WORKER_PASSWORD=<synthetic-worker-password>
ORGANIZER_EMAIL=organizer@test.opskil.local
ORGANIZER_PASSWORD=<synthetic-organizer-password>
