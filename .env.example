# ==============================================================================
# OPSKL ENVIRONMENT VARIABLES MASTER CONFIGURATION
# ==============================================================================
# Rules:
# 1. Variables prefixed with EXPO_PUBLIC_ are embedded directly into mobile bundles.
# 2. Variables prefixed with NEXT_PUBLIC_ are embedded into web bundles.
# 3. NEVER prefix secrets (service role keys, DB passwords, private keys) with
#    EXPO_PUBLIC_ or NEXT_PUBLIC_!
# ==============================================================================

# --- MOBILE APPS (Worker & Organizer Expo Apps) ---
# Safe for client mobile bundle
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
EXPO_PUBLIC_APP_ENV="development"
EXPO_PUBLIC_DEFAULT_CITY="Mumbai"
EXPO_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"

# --- ADMIN WEB DASHBOARD (Next.js) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_CITY="Mumbai"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# --- SERVER-ONLY SECRETS (Supabase Edge Functions / Admin Server Actions ONLY) ---
# CRITICAL: DO NOT EXPOSE TO EXPO APPS OR CLIENT JAVASCRIPT!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
