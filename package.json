{
  "name": "opskil-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:worker": "npm --workspace=@opskil/worker run start",
    "start:organizer": "npm --workspace=@opskil/organizer run start",
    "android:worker": "npm --workspace=@opskil/worker run android",
    "ios:worker": "npm --workspace=@opskil/worker run ios",
    "android:organizer": "npm --workspace=@opskil/organizer run android",
    "ios:organizer": "npm --workspace=@opskil/organizer run ios",
    "dev:admin": "npm --workspace=@opskil/admin run dev",
    "build:admin": "npm --workspace=@opskil/admin run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e:admin": "npm --workspace=@opskil/admin run test:e2e",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "semver": "^7.8.5"
  }
}
